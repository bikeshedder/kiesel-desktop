#!/usr/bin/env bash
# kiesel-headless – a private headless Wayland session for tests and screenshots.
#
#   kiesel-headless start [--size 1280x800] [--scale 1] [--refresh 60]
#                                                         start sway + D-Bus + AT-SPI
#   kiesel-headless run <cmd> [args…]                     run a command inside the session
#   kiesel-headless env                                   print exports (eval "$(kiesel-headless env)")
#   kiesel-headless shot [file.png]                       screenshot of the whole output
#   kiesel-headless move <x> <y>                          move the pointer to logical x,y
#   kiesel-headless click <x> <y> [left|right|middle]     move there and click
#   kiesel-headless down|up [button]                      press / release (drag, hold)
#   kiesel-headless wheel <notches>                       mouse wheel (positive = down)
#   kiesel-headless swipe <dy> [steps] [ms]               two-finger touchpad scroll, then lift
#   kiesel-headless scroll <dy>                           one bare vertical axis event
#   kiesel-headless key <combo>                           press and release, e.g. Tab, shift+Tab, space
#   kiesel-headless keydown|keyup <combo>                 hold / let go
#   kiesel-headless type <text>                           type text (us layout)
#   kiesel-headless ime preedit|commit <text>             act as the input method (also: clear,
#                                                         delete <before> <after>; fails unless a
#                                                         client has text input on)
#   kiesel-headless portal light|dark|none                the system's colour-scheme preference, served
#                                                         by a fake XDG portal (tools/fake-portal.py)
#   kiesel-headless a11y                                  dump the AT-SPI tree of running apps
#   kiesel-headless a11y click|focus <name>               act on the first node with that name
#                                                         (--role <role> before the name narrows it,
#                                                         e.g. a11y box --role entry Name)
#   kiesel-headless a11y where <name>                     its centre in logical coordinates
#   kiesel-headless a11y box <name>                       its x y width height (logical)
#   kiesel-headless a11y value <name>                     its value (text fields)
#   kiesel-headless a11y set <name> = <value>             set its value, as a screen reader would
#   kiesel-headless a11y caret <name> [= offset]          print (or move) its caret, in characters
#   kiesel-headless a11y scrollto <name>                  ask to scroll it into view (Component.ScrollTo)
#   kiesel-headless stop
#
# Software rendering only: sway uses the pixman renderer, clients get Mesa's
# lavapipe (Vulkan) and llvmpipe (GL). The VS Code container sets WAYLAND_DISPLAY
# and DISPLAY to the editor's own forwarded sockets; everything here overrides
# them so tests never draw on the host.
set -euo pipefail

RUN_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-$(id -u)}"
STATE="$RUN_DIR/kiesel-headless"
OUTPUT=HEADLESS-1
WORKSPACE="${KIESEL_WORKSPACE:-/workspaces/kiesel-desktop}"

die() { echo "kiesel-headless: $*" >&2; exit 1; }
running() { [[ -f "$STATE/env" ]] && kill -0 "$(cat "$STATE/sway.pid" 2>/dev/null)" 2>/dev/null; }
need() { running || die "no session – run 'kiesel-headless start' first"; }
load() { need; set -a; source "$STATE/env"; set +a; unset DISPLAY; }

start() {
  local size=1280x800 scale=1 refresh=60
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --size) size="$2"; shift 2 ;;
      --scale) scale="$2"; shift 2 ;;
      --refresh) refresh="$2"; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  running && die "already running (kiesel-headless stop first)"
  mkdir -p -m 700 "$RUN_DIR" "$STATE"
  rm -f "$STATE"/*

  # D-Bus session bus, with the AT-SPI bus switched on (AccessKit only exposes
  # its tree when org.a11y.Status says assistive technology is active)
  dbus-daemon --session --fork --address="unix:path=$STATE/bus" --print-pid >"$STATE/dbus.pid"
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$STATE/bus"
  /usr/libexec/at-spi-bus-launcher --launch-immediately >"$STATE/atspi.log" 2>&1 &
  echo $! >"$STATE/atspi.pid"
  for _ in $(seq 50); do
    gdbus call --session --dest org.a11y.Bus --object-path /org/a11y/bus \
      --method org.freedesktop.DBus.Properties.Set org.a11y.Status IsEnabled '<true>' >/dev/null 2>&1 && break
    sleep 0.1
  done

  # Plain sway: no bar, no borders, one fullscreen-ish tiled window; Xwayland
  # off so nothing can silently fall back to X11
  # --size is logical; the output's mode is in pixels (1280x800 @ 2 → 2560x1600)
  local w h
  w=$(awk -v v="${size%x*}" -v s="$scale" 'BEGIN { printf "%d", v * s + 0.5 }')
  h=$(awk -v v="${size#*x}" -v s="$scale" 'BEGIN { printf "%d", v * s + 0.5 }')
  cat >"$STATE/sway.conf" <<EOF
xwayland disable
default_border none
default_floating_border none
focus_follows_mouse no
output $OUTPUT mode --custom ${w}x${h}@${refresh}Hz position 0 0 scale $scale bg #e4e8ee solid_color
seat * hide_cursor 0
exec sh -c 'printf "WAYLAND_DISPLAY=%s\nSWAYSOCK=%s\n" "\$WAYLAND_DISPLAY" "\$SWAYSOCK" > "$STATE/sway.env"'
EOF
  env -u WAYLAND_DISPLAY -u DISPLAY \
    XDG_RUNTIME_DIR="$RUN_DIR" WLR_BACKENDS=headless WLR_RENDERER=pixman \
    WLR_LIBINPUT_NO_DEVICES=1 WLR_HEADLESS_OUTPUTS=1 \
    sway -c "$STATE/sway.conf" >"$STATE/sway.log" 2>&1 &
  echo $! >"$STATE/sway.pid"
  for _ in $(seq 100); do [[ -s "$STATE/sway.env" ]] && break; sleep 0.1; done
  [[ -s "$STATE/sway.env" ]] || { cat "$STATE/sway.log" >&2; stop; die "sway did not come up"; }

  # One virtual pointer and keyboard for the whole session (tools/kiesel-input):
  # a device per command (wlrctl, wtype) appears and vanishes before clients
  # can bind it
  local input="$WORKSPACE/target/debug/kiesel-input"
  cargo build -q --manifest-path "$WORKSPACE/Cargo.toml" -p kiesel-input
  mkfifo "$STATE/input.in" "$STATE/input.ack"
  env -u DISPLAY XDG_RUNTIME_DIR="$RUN_DIR" $(cat "$STATE/sway.env") \
    "$input" "${size%x*}" "${size#*x}" "$STATE/input.in" "$STATE/input.ack" >"$STATE/input.log" 2>&1 &
  echo $! >"$STATE/input.pid"

  {
    echo "XDG_RUNTIME_DIR=$RUN_DIR"
    cat "$STATE/sway.env"
    echo "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS"
    echo "KIESEL_HEADLESS_SCALE=$scale"
    echo "WINIT_UNIX_BACKEND=wayland"
    echo "XDG_SESSION_TYPE=wayland"
  } >"$STATE/env"
  echo "headless session up: $size @ scale $scale = ${w}x${h} px, ${refresh} Hz ($(grep WAYLAND_DISPLAY "$STATE/sway.env"))"
}

stop() {
  for p in portal input sway atspi dbus; do
    [[ -f "$STATE/$p.pid" ]] && kill "$(cat "$STATE/$p.pid")" 2>/dev/null || true
  done
  rm -f "$STATE"/*.pid "$STATE/env" "$STATE/sway.env" "$STATE"/input.in "$STATE"/input.ack
}

# Starts the fake portal on first use, then sets its colour-scheme
portal() {
  load
  local value
  case "${1:-}" in
    none) value=0 ;;
    dark) value=1 ;;
    light) value=2 ;;
    *) die "portal light|dark|none" ;;
  esac
  if ! kill -0 "$(cat "$STATE/portal.pid" 2>/dev/null)" 2>/dev/null; then
    python3 "$WORKSPACE/tools/fake-portal.py" "$value" >"$STATE/portal.log" 2>&1 &
    echo $! >"$STATE/portal.pid"
    for _ in $(seq 50); do grep -q ready "$STATE/portal.log" 2>/dev/null && return; sleep 0.1; done
    die "the fake portal did not start (see $STATE/portal.log)"
  fi
  gdbus call --session --dest org.freedesktop.portal.Desktop --object-path /org/freedesktop/portal/desktop \
    --method org.kiesel.FakePortal.SetColorScheme "$value" >/dev/null
}

# Sends one command to kiesel-input and waits until it has been delivered
input() {
  need
  kill -0 "$(cat "$STATE/input.pid" 2>/dev/null)" 2>/dev/null || die "kiesel-input is not running (see $STATE/input.log)"
  exec 3<>"$STATE/input.ack"
  echo "$*" >"$STATE/input.in"
  local reply
  read -r -t 5 reply <&3 || die "no answer from kiesel-input"
  exec 3>&-
  [[ "$reply" == ok ]] || die "$reply"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  start) start "$@" ;;
  stop) stop ;;
  env) need; sed 's/^/export /' "$STATE/env"; echo "unset DISPLAY" ;;
  run) load; exec "$@" ;;
  shot) load; exec grim -o "$OUTPUT" "${1:-shot.png}" ;;
  move) [[ $# -eq 2 ]] || die "move <x> <y>"; input move "$@" ;;
  click) [[ $# -ge 2 ]] || die "click <x> <y> [button]"; input click "$@" ;;
  down | up) input "$cmd" "$@" ;;
  scroll) [[ $# -eq 1 ]] || die "scroll <dy>"; input scroll "$1" ;;
  wheel) [[ $# -eq 1 ]] || die "wheel <notches>"; input wheel "$1" ;;
  swipe) [[ $# -ge 1 ]] || die "swipe <dy> [steps] [ms]"; input swipe "$1" "${2:-10}" "${3:-100}" ;;
  key | keydown | keyup) [[ $# -eq 1 ]] || die "$cmd <combo>"; input "$cmd" "$1" ;;
  type) [[ $# -ge 1 ]] || die "type <text>"; input type "$*" ;;
  ime) [[ $# -ge 1 ]] || die "ime preedit|commit|clear|delete …"; input ime "$*" ;;
  portal) portal "$@" ;;
  a11y)
    load
    exec python3 - "$@" <<'EOF'
import sys
import pyatspi

def walk(acc, depth=0):
    try:
        states = [pyatspi.stateToString(s) for s in acc.getState().getStates()
                  if s in (pyatspi.STATE_FOCUSED, pyatspi.STATE_BUSY, pyatspi.STATE_PRESSED, pyatspi.STATE_CHECKED)]
        print(f"{'  ' * depth}{acc.getRoleName()} {acc.name!r} {' '.join(states)}".rstrip())
        for child in acc:
            walk(child, depth + 1)
    except Exception as e:
        print(f"{'  ' * depth}<{e}>")

def find(acc, name, role=None):
    if acc.name == name and acc.getRoleName() != "application" and role in (None, acc.getRoleName()):
        return acc
    for child in acc:
        hit = find(child, name, role)
        if hit:
            return hit
    return None

desktop = pyatspi.Registry.getDesktop(0)
if len(sys.argv) == 1:
    walk(desktop)
    sys.exit()
verb, args, role = sys.argv[1], sys.argv[2:], None
if args[:1] == ["--role"]:
    role, args = args[1], args[2:]
value = None
if "=" in args:
    i = args.index("=")
    args, value = args[:i], " ".join(args[i + 1:])
elif verb == "set":
    sys.exit("a11y set <name> = <value>")
name = " ".join(args)
# nodes added a moment ago may not have reached the registry yet: ask again briefly
import time
for _ in range(10):
    acc = find(desktop, name, role)
    if acc is not None:
        break
    time.sleep(0.1)
    desktop = pyatspi.Registry.getDesktop(0)
if acc is None:
    sys.exit(f"no accessible named {name!r}")
if verb == "click":
    action = acc.queryAction()
    names = [action.getName(i) for i in range(action.nActions)]
    if "click" not in names:
        sys.exit(f"{name!r} has no click action (has {names})")
    action.doAction(names.index("click"))
elif verb == "focus":
    acc.queryComponent().grabFocus()
elif verb == "value":
    text = acc.queryText()
    print(text.getText(0, text.characterCount))
elif verb == "scrollto":
    if not acc.queryComponent().scrollTo(pyatspi.SCROLL_ANYWHERE):
        sys.exit(f"{name!r} could not be scrolled into view")
elif verb == "caret":
    text = acc.queryText()
    if value is None:
        print(text.caretOffset)
    elif not text.setCaretOffset(int(value)):
        sys.exit(f"{name!r} refused the caret offset")
elif verb == "set":
    if not acc.queryEditableText().setTextContents(value):
        sys.exit(f"{name!r} refused the value")
elif verb in ("where", "box"):
    # Wayland windows sit at the origin here (one tiled window); extents are pixels
    import os
    scale = float(os.environ.get("KIESEL_HEADLESS_SCALE", "1"))
    x, y, w, h = (v / scale for v in acc.queryComponent().getExtents(pyatspi.DESKTOP_COORDS))
    print(f"{x + w / 2:.0f} {y + h / 2:.0f}" if verb == "where" else f"{x:.0f} {y:.0f} {w:.0f} {h:.0f}")
else:
    sys.exit(f"unknown a11y verb {verb}")
EOF
    ;;
  *) sed -n '2,35p' "$0" | sed 's/^# \{0,1\}//'; [[ -z "$cmd" ]] || exit 1 ;;
esac
